# URL of the CRM application.
# Development: CRM runs on port 3001 (npm run dev in the CRM folder).
# Production:  point this to your deployed CRM domain (e.g. https://app.fitkalp.com)
NEXT_PUBLIC_CRM_URL="http://localhost:3001"

# Server-only CRM origin used by the inquiry proxy. May use an internal URL.
CRM_SERVER_URL="http://localhost:3001"

# ─────────────────────────────────────────────────────────────────────────────
# Founder Admin Portal Security (Triple-Key Authentication)
# Set three unique, complex passwords and a cryptographically strong secret.
# Enclose passwords in quotes to safely use special characters (#, $, @, !, etc.)
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD_1="your-first-complex-password-here"
ADMIN_PASSWORD_2="your-second-complex-password-here"
ADMIN_PASSWORD_3="your-third-complex-password-here"
ADMIN_SECRET_KEY="generate-a-strong-random-hex-string-for-session-tokens"
